rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isOwner() { return signedIn() && exists(/databases/$(database)/documents/owners/$(request.auth.uid)); }
    function isTester() { return signedIn() && exists(/databases/$(database)/documents/testers/$(request.auth.uid)); }
    // Staff = owners + testers: review organizations and edit content.
    function isStaff() { return isOwner() || isTester(); }
    // Organizers = verified organizations: they create events and manage their roles.
    function isOrganizer() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('orgStatus', '') == 'verified';
    }
    // Event helpers: volunteers accepted into an event role with category "Organizer".
    function isEventHelper(eventId) {
      return signedIn() && exists(/databases/$(database)/documents/eventHelpers/$(eventId + '_' + request.auth.uid));
    }
    function ownsEvent(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data.get('createdBy', '') == request.auth.uid;
    }
    function isMember(data) { return signedIn() && request.auth.uid in data.members; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // Public content — readable by anyone. Staff can edit everything;
    // organizers can create events and manage only their own events and those events' roles.
    match /leagues/{id} { allow read: if true; allow write: if isStaff(); }

    match /events/{id} {
      allow read: if true;
      allow create: if isStaff() || (isOrganizer() && request.resource.data.createdBy == request.auth.uid);
      allow update: if isStaff() || (isOrganizer()
        && resource.data.get('createdBy', '') == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid);
      allow delete: if isStaff() || (isOrganizer() && resource.data.get('createdBy', '') == request.auth.uid);
    }

    match /jobs/{id} {
      allow read: if true;
      allow create: if isStaff() || (isOrganizer() && ownsEvent(request.resource.data.eventId));
      allow update: if isStaff() || (isOrganizer()
        && ownsEvent(resource.data.eventId)
        && ownsEvent(request.resource.data.eventId))
        // Event helpers only keep the accepted counter in step when they accept/decline.
        || (isEventHelper(resource.data.eventId) && changed().hasOnly(['acceptedCount']))
        // An accepted volunteer withdrawing frees their spot, in the same batch that deletes their application.
        || (signedIn()
          && changed().hasOnly(['acceptedCount'])
          && request.resource.data.acceptedCount == resource.data.get('acceptedCount', 0) - 1
          && get(/databases/$(database)/documents/jobs/$(id)/applications/$(request.auth.uid)).data.status == 'accepted'
          && !existsAfter(/databases/$(database)/documents/jobs/$(id)/applications/$(request.auth.uid)));
      allow delete: if isStaff() || (isOrganizer() && ownsEvent(resource.data.eventId));

      // Volunteer applications: doc id = applicant uid. Personal accounts apply (status pending);
      // the event's creator or staff accept/decline; event helpers too, except for Organizer roles.
      // Applicants see only their own.
      match /applications/{uid} {
        function job() { return get(/databases/$(database)/documents/jobs/$(id)).data; }
        function canManageJob() {
          return isStaff() || (isOrganizer() && ownsEvent(job().eventId)) || canHelpJob();
        }
        function canHelpJob() {
          return isEventHelper(job().eventId) && job().get('category', '') != 'Organizer';
        }
        allow read: if isSelf(uid) || canManageJob();
        allow create: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'status', 'appliedAt'])
          && request.resource.data.uid == uid
          && request.resource.data.status == 'pending'
          && get(/databases/$(database)/documents/users/$(uid)).data.get('accountType', 'personal') != 'organization';
        allow update: if canManageJob()
          && changed().hasOnly(['status', 'reviewedBy', 'reviewedAt'])
          && request.resource.data.status in ['pending', 'accepted', 'declined'];
        allow delete: if isSelf(uid) || (canManageJob() && !canHelpJob());
      }
    }

    // eventHelpers/{eventId_uid} { eventId, uid, name, jobId }: written when someone is accepted into
    // (or leaves) an "Organizer" role. Only the event's organization or staff grant it; the helper can drop it.
    match /eventHelpers/{helperId} {
      allow read: if signedIn();
      allow create: if (isStaff() || (isOrganizer() && ownsEvent(request.resource.data.eventId)))
        && helperId == request.resource.data.eventId + '_' + request.resource.data.uid;
      allow delete: if isStaff() || (isOrganizer() && ownsEvent(resource.data.eventId)) || isSelf(resource.data.uid);
    }

    // Owners: the first owner must be added in the Firebase console (doc id = their auth UID).
    // Only owners can add/remove owners and testers.
    match /owners/{uid} {
      allow read: if signedIn();
      allow write: if isOwner();
    }
    match /testers/{uid} {
      allow read: if signedIn();
      allow write: if isOwner();
    }

    // Profiles. accountType can never change; orgStatus is set by staff
    // (the org itself may only move it from rejected back to pending when resubmitting).
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if isSelf(uid) && (
        (request.resource.data.accountType == 'personal' && !('orgStatus' in request.resource.data)) ||
        (request.resource.data.accountType == 'organization' && request.resource.data.orgStatus == 'pending')
      );
      allow update: if
        (isSelf(uid) && !changed().hasAny(['accountType', 'orgStatus'])) ||
        (isSelf(uid) && !changed().hasAny(['accountType'])
          && resource.data.orgStatus in ['pending', 'rejected']
          && request.resource.data.orgStatus == 'pending') ||
        (isStaff() && changed().hasOnly(['orgStatus', 'updatedAt']));
    }

    // Organization verification requests: private to the organization and staff.
    match /orgApplications/{uid} {
      allow read: if isSelf(uid) || isStaff();
      allow create: if isSelf(uid)
        && request.resource.data.status == 'pending'
        && request.resource.data.emailVerified == false;
      // The org can edit while pending/rejected (always ending as pending), and can only
      // mark its email as verified if Firebase Auth says it is.
      allow update: if
        (isSelf(uid)
          && resource.data.status in ['pending', 'rejected']
          && request.resource.data.status == 'pending'
          && request.resource.data.verificationCode == resource.data.verificationCode
          && (request.resource.data.emailVerified == false || request.auth.token.email_verified == true)
          && !changed().hasAny(['reviewedBy', 'reviewedAt'])) ||
        isStaff();
    }

    // Friendships: doc id is "<uidA>_<uidB>" (sorted).
    match /friendships/{id} {
      allow read: if signedIn() && (resource == null || isMember(resource.data));
      allow create: if isMember(request.resource.data)
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.members.size() == 2;
      // Only the person who received the request can accept it.
      allow update: if isMember(resource.data)
        && resource.data.requestedBy != request.auth.uid
        && request.resource.data.status == 'accepted'
        && request.resource.data.members == resource.data.members;
      allow delete: if isMember(resource.data);
    }

    // Chats (direct + group) and their messages: members only.
    match /chats/{chatId} {
      allow read: if signedIn() && (resource == null || isMember(resource.data));
      allow create: if isMember(request.resource.data);
      allow update: if isMember(resource.data);

      match /messages/{messageId} {
        allow read: if isMember(get(/databases/$(database)/documents/chats/$(chatId)).data);
        allow create: if isMember(get(/databases/$(database)/documents/chats/$(chatId)).data)
          && request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}
