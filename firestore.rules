rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function isOwner() { return signedIn() && exists(/databases/$(database)/documents/owners/$(request.auth.uid)); }
    function isTester() { return signedIn() && exists(/databases/$(database)/documents/testers/$(request.auth.uid)); }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    // Staff = owners + admins + testers: review organizations and edit content.
    function isStaff() { return isOwner() || isAdmin() || isTester(); }
    // Organizers = verified organizations: they create events and manage their roles.
    function isOrganizer() {
      return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('orgStatus', '') == 'verified';
    }
    // Event helpers: volunteers accepted into an event role with category "Organizer".
    function isEventHelper(eventId) {
      return signedIn() && exists(/databases/$(database)/documents/eventHelpers/$(eventId + '_' + request.auth.uid));
    }
    function ownsEvent(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data.get('createdBy', '') == request.auth.uid;
    }
    // Minimum age 16 (keep in sync with MIN_AGE in src/config.js). bd = "YYYY-MM-DD".
    function isOldEnough(bd) {
      return bd is string && bd.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && timestamp.date(int(bd[0:4]) + 16, int(bd[5:7]), int(bd[8:10])) <= request.time;
    }
    // True if `a` is the person's current age for birth date bd.
    function ageMatches(bd, a) {
      return a is int
        && timestamp.date(int(bd[0:4]) + a, int(bd[5:7]), int(bd[8:10])) <= request.time
        && request.time < timestamp.date(int(bd[0:4]) + a + 1, int(bd[5:7]), int(bd[8:10]));
    }
    // Private profile part (birth date). Readable only by the person and staff.
    function privPath(uid) { return /databases/$(database)/documents/users/$(uid)/private/profile; }
    function isMember(data) { return signedIn() && request.auth.uid in data.members; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    // Names copied onto other docs (messages, chat previews, memberNames, applications) must be the
    // writer's real profile name, so nobody can post as someone else. Role tags are pills drawn by the
    // app from the role docs, never from these strings.
    function myName() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('displayName', ''); }
    // In a { uid: name } map, the writer's own entry (if any) is their real name.
    function ownNameOk(names) { return !(request.auth.uid in names) || names[request.auth.uid] == myName(); }

    // Public content — readable by anyone. Staff can edit everything;
    // organizers can create events and manage only their own events and those events' roles.
    match /leagues/{id} { allow read: if true; allow write: if isStaff(); }

    match /events/{id} {
      allow read: if true;
      allow create: if isStaff() || (isOrganizer() && request.resource.data.createdBy == request.auth.uid);
      allow update: if isStaff() || (isOrganizer()
        && resource.data.get('createdBy', '') == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid);
      allow delete: if isStaff() || (isOrganizer() && resource.data.get('createdBy', '') == request.auth.uid);
    }

    match /jobs/{id} {
      allow read: if true;
      allow create: if isStaff() || (isOrganizer() && ownsEvent(request.resource.data.eventId));
      allow update: if isStaff() || (isOrganizer()
        && ownsEvent(resource.data.eventId)
        && ownsEvent(request.resource.data.eventId))
        // Event helpers only keep the accepted counter in step when they accept/decline.
        || (isEventHelper(resource.data.eventId) && changed().hasOnly(['acceptedCount']))
        // An accepted volunteer withdrawing frees their spot, in the same batch that deletes their application.
        || (signedIn()
          && changed().hasOnly(['acceptedCount'])
          && request.resource.data.acceptedCount == resource.data.get('acceptedCount', 0) - 1
          && get(/databases/$(database)/documents/jobs/$(id)/applications/$(request.auth.uid)).data.status == 'accepted'
          && !existsAfter(/databases/$(database)/documents/jobs/$(id)/applications/$(request.auth.uid)));
      allow delete: if isStaff() || (isOrganizer() && ownsEvent(resource.data.eventId));

      // Volunteer applications: doc id = applicant uid. Personal accounts apply (status pending);
      // the event's creator or staff accept/decline; event helpers too, except for Organizer roles.
      // Applicants see only their own.
      match /applications/{uid} {
        function job() { return get(/databases/$(database)/documents/jobs/$(id)).data; }
        function canManageJob() {
          return isStaff() || (isOrganizer() && ownsEvent(job().eventId)) || canHelpJob();
        }
        function canHelpJob() {
          return isEventHelper(job().eventId) && job().get('category', '') != 'Organizer';
        }
        allow read: if isSelf(uid) || canManageJob();
        // `age` (shown to the organizers) must be the applicant's real current age from their private birth date.
        allow create: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'status', 'appliedAt', 'age'])
          && request.resource.data.uid == uid
          && request.resource.data.status == 'pending'
          && request.resource.data.get('name', '') == myName()
          && get(/databases/$(database)/documents/users/$(uid)).data.get('accountType', 'personal') != 'organization'
          && ((exists(privPath(uid)) && ageMatches(get(privPath(uid)).data.birthDate, request.resource.data.get('age', -1)))
            || (!exists(privPath(uid)) && !('age' in request.resource.data)));
        allow update: if canManageJob()
          && changed().hasOnly(['status', 'reviewedBy', 'reviewedAt'])
          && request.resource.data.status in ['pending', 'accepted', 'declined'];
        allow delete: if isSelf(uid) || (canManageJob() && !canHelpJob());
      }
    }

    // eventHelpers/{eventId_uid} { eventId, uid, name, jobId }: written when someone is accepted into
    // (or leaves) an "Organizer" role. Only the event's organization or staff grant it; the helper can drop it.
    match /eventHelpers/{helperId} {
      allow read: if signedIn();
      allow create: if (isStaff() || (isOrganizer() && ownsEvent(request.resource.data.eventId)))
        && helperId == request.resource.data.eventId + '_' + request.resource.data.uid;
      allow delete: if isStaff() || (isOrganizer() && ownsEvent(resource.data.eventId)) || isSelf(resource.data.uid);
    }

    // Owners: the first owner must be added in the Firebase console (doc id = their auth UID).
    // Owners add/remove owners and admins; owners and admins add/remove testers.
    match /owners/{uid} {
      allow read: if signedIn();
      allow write: if isOwner();
    }
    match /admins/{uid} {
      allow read: if signedIn();
      allow write: if isOwner();
    }
    match /testers/{uid} {
      allow read: if signedIn();
      allow write: if isOwner() || isAdmin();
    }

    // Profiles. accountType can never change; orgStatus is set by staff
    // (the org itself may only move it from rejected back to pending when resubmitting).
    // The public profile never holds the birth date (it lives in users/{uid}/private/profile).
    match /users/{uid} {
      // Brackets are reserved for role tags like [OWN], so names can't contain any bracket
      // ([] () {} <>), the symbols \ | /, or their look-alikes. Same list as src/profile/names.js.
      // (?s) so a line break can't hide one.
      function noBrackets(s) {
        return s is string
          && !s.matches('(?s).*[\\[\\](){}<>\\\\|/［］（）｛｝＜＞＼｜／【】〔〕〖〗⟦⟧⟨⟩〈〉《》「」『』❨❩❪❫❴❵¦∣⁄∕⧸⧹].*');
      }
      // Optional nickname shown under the photo on Profile (max 30 characters, like the app field).
      function validNickname() {
        return !('nickname' in request.resource.data)
          || (noBrackets(request.resource.data.nickname) && request.resource.data.nickname.size() <= 30);
      }
      // Checked only when the name changes, so older names don't block other profile edits.
      function validNameChange() {
        return !changed().hasAny(['displayName']) || noBrackets(request.resource.data.displayName);
      }
      allow read: if signedIn();
      allow create: if isSelf(uid) && !('birthDate' in request.resource.data) && validNickname()
        && noBrackets(request.resource.data.displayName) && (
        // Personal: a 16+ private birth date must be written in the same batch. Only staff
        // (owners/admins/testers, set up in the console) may start without one.
        (request.resource.data.accountType == 'personal' && !('orgStatus' in request.resource.data)
          && ((existsAfter(privPath(uid)) && isOldEnough(getAfter(privPath(uid)).data.birthDate)) || isStaff())) ||
        (request.resource.data.accountType == 'organization' && request.resource.data.orgStatus == 'pending')
      );
      allow update: if !('birthDate' in request.resource.data) && validNickname() && validNameChange() && (
        (isSelf(uid) && !changed().hasAny(['accountType', 'orgStatus'])) ||
        (isSelf(uid) && !changed().hasAny(['accountType'])
          && resource.data.orgStatus in ['pending', 'rejected']
          && request.resource.data.orgStatus == 'pending') ||
        (isStaff() && changed().hasOnly(['orgStatus', 'updatedAt'])));
      // Account deletion (the app removes the person's other data first).
      allow delete: if isSelf(uid);

      // High-resolution profile photo (JPEG data URI), loaded only in the full-screen viewer.
      // Same visibility as the profile; only the owner can change it. Capped below Firestore's 1 MB limit.
      match /photo/full {
        allow read: if signedIn();
        allow write: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['data'])
          && request.resource.data.data is string
          && request.resource.data.data.size() < 900000;
        allow delete: if isSelf(uid);
      }

      // Birth date: set once (16+), never changed, visible only to the person and staff.
      match /private/profile {
        allow read: if isSelf(uid) || isStaff();
        allow create: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['birthDate'])
          && isOldEnough(request.resource.data.birthDate);
        allow delete: if isSelf(uid);
      }
    }

    // Organization verification requests: private to the organization and staff.
    match /orgApplications/{uid} {
      allow read: if isSelf(uid) || isStaff();
      allow create: if isSelf(uid)
        && request.resource.data.status == 'pending'
        && request.resource.data.emailVerified == false;
      // The org can edit while pending/rejected (always ending as pending), and can only
      // mark its email as verified if Firebase Auth says it is.
      allow update: if
        (isSelf(uid)
          && resource.data.status in ['pending', 'rejected']
          && request.resource.data.status == 'pending'
          && request.resource.data.verificationCode == resource.data.verificationCode
          && (request.resource.data.emailVerified == false || request.auth.token.email_verified == true)
          && !changed().hasAny(['reviewedBy', 'reviewedAt'])) ||
        isStaff();
      allow delete: if isSelf(uid); // account deletion
    }

    // Friendships: doc id is "<uidA>_<uidB>" (sorted).
    match /friendships/{id} {
      allow read: if signedIn() && (resource == null || isMember(resource.data));
      allow create: if isMember(request.resource.data)
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.members.size() == 2
        && ownNameOk(request.resource.data.get('memberNames', {}));
      // Only the person who received the request can accept it (and only the status changes).
      allow update: if isMember(resource.data)
        && resource.data.requestedBy != request.auth.uid
        && request.resource.data.status == 'accepted'
        && changed().hasOnly(['status']);
      allow delete: if isMember(resource.data);
    }

    // Team chats: two fixed chats whose access comes from the role, not a member list, so they
    // follow Admin → Team changes automatically. team_owners = owners; team_staff = owners + admins + testers.
    function isTeamChat(chatId) { return chatId in ['team_owners', 'team_staff']; }
    function inTeamChat(chatId) {
      return (chatId == 'team_owners' && isOwner()) || (chatId == 'team_staff' && isStaff());
    }
    function chatData(chatId) { return get(/databases/$(database)/documents/chats/$(chatId)).data; }
    function canUseChat(chatId) {
      return (isTeamChat(chatId) && inTeamChat(chatId)) || (!isTeamChat(chatId) && isMember(chatData(chatId)));
    }

    // Chats (direct + group) and their messages: members only. Team chats: by role (above).
    match /chats/{chatId} {
      allow get: if signedIn() && ((isTeamChat(chatId) && inTeamChat(chatId))
        || (!isTeamChat(chatId) && (resource == null || isMember(resource.data))));
      allow list: if signedIn() && isMember(resource.data);
      allow create: if (isTeamChat(chatId) && inTeamChat(chatId)
          && request.resource.data.type == 'team'
          && request.resource.data.keys().hasOnly(['type', 'name', 'lastMessage', 'lastSender', 'createdAt', 'updatedAt']))
        || (!isTeamChat(chatId) && isMember(request.resource.data)
          && ownNameOk(request.resource.data.get('memberNames', {})));
      // lastSender = the writer's real name. In memberNames you can only touch your own entry
      // (leaving removes it; if present it must be your real name).
      allow update: if (!changed().hasAny(['lastSender']) || request.resource.data.lastSender == myName()) && (
        (isTeamChat(chatId) && inTeamChat(chatId) && changed().hasOnly(['lastMessage', 'lastSender', 'updatedAt']))
        || (!isTeamChat(chatId) && isMember(resource.data)
          && (!changed().hasAny(['memberNames'])
            || (request.resource.data.get('memberNames', {}).diff(resource.data.get('memberNames', {})).affectedKeys().hasOnly([request.auth.uid])
              && ownNameOk(request.resource.data.get('memberNames', {}))))));

      match /messages/{messageId} {
        allow read: if canUseChat(chatId);
        allow create: if canUseChat(chatId) && request.resource.data.senderId == request.auth.uid
          && request.resource.data.get('senderName', '') == myName();
      }
    }
  }
}
